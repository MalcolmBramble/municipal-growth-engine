{
  "dimensions": {
    "population_demographics": {
      "label": "Population & Demographics",
      "weight": 1,
      "indicators": {
        "poverty_rate": {
          "source_field": "poverty_rate",
          "direction": "lower_is_better",
          "thresholds": [
            {"max": 10, "score": 2},
            {"min": 10, "max": 13, "score": 1},
            {"min": 13, "max": 16, "score": 0},
            {"min": 16, "max": 22, "score": -1},
            {"min": 22, "score": -2}
          ]
        },
        "median_income_ratio": {
          "source_field": "median_income",
          "type": "ratio",
          "national_benchmark": 80610,
          "thresholds": [
            {"min_ratio": 1.10, "score": 2},
            {"min_ratio": 0.95, "max_ratio": 1.10, "score": 1},
            {"min_ratio": 0.80, "max_ratio": 0.95, "score": 0},
            {"min_ratio": 0.60, "max_ratio": 0.80, "score": -1},
            {"max_ratio": 0.60, "score": -2}
          ]
        },
        "population_growth": {
          "source_field": "population_growth_rate",
          "direction": "higher_is_better",
          "thresholds": [
            {"min": 1.0, "score": 2},
            {"min": 0.3, "max": 1.0, "score": 1},
            {"min": -0.3, "max": 0.3, "score": 0},
            {"min": -1.0, "max": -0.3, "score": -1},
            {"max": -1.0, "score": -2}
          ]
        }
      }
    },
    "housing_market": {
      "label": "Housing Market",
      "weight": 1,
      "indicators": {
        "price_yoy": {
          "source_field": "price_yoy_change",
          "fallback_field": "zhvi_yoy_change",
          "direction": "higher_is_better",
          "thresholds": [
            {"min": 8, "score": 2},
            {"min": 3, "max": 8, "score": 1},
            {"min": 0, "max": 3, "score": 0},
            {"min": -5, "max": 0, "score": -1},
            {"max": -5, "score": -2}
          ]
        },
        "price_to_income": {
          "source_field": "price_to_income_ratio",
          "direction": "lower_is_better",
          "thresholds": [
            {"max": 3.0, "score": 2},
            {"min": 3.0, "max": 4.0, "score": 1},
            {"min": 4.0, "max": 5.0, "score": 0},
            {"min": 5.0, "max": 7.0, "score": -1},
            {"min": 7.0, "score": -2}
          ]
        }
      }
    },
    "economic_base": {
      "label": "Economic Base",
      "weight": 1,
      "indicators": {
        "unemployment_rate": {
          "source_field": "unemployment_rate",
          "direction": "lower_is_better",
          "thresholds": [
            {"max": 3.5, "score": 2},
            {"min": 3.5, "max": 4.5, "score": 1},
            {"min": 4.5, "max": 6, "score": 0},
            {"min": 6, "max": 8, "score": -1},
            {"min": 8, "score": -2}
          ]
        },
        "unemployment_trend": {
          "source_field": "unemployment_trend",
          "direction": "lower_is_better",
          "thresholds": [
            {"max": -1.0, "score": 2},
            {"min": -1.0, "max": -0.3, "score": 1},
            {"min": -0.3, "max": 0.3, "score": 0},
            {"min": 0.3, "max": 1.0, "score": -1},
            {"min": 1.0, "score": -2}
          ]
        }
      }
    },
    "fiscal_health": {
      "label": "Fiscal Health",
      "weight": 1,
      "requires_manual": true,
      "indicators": {}
    },
    "infrastructure": {
      "label": "Infrastructure & Capital Investment",
      "weight": 1,
      "indicators": {
        "walk_score": {
          "source_field": "walk_score",
          "direction": "higher_is_better",
          "thresholds": [
            {"min": 80, "score": 2},
            {"min": 70, "max": 80, "score": 1},
            {"min": 50, "max": 70, "score": 0},
            {"min": 30, "max": 50, "score": -1},
            {"max": 30, "score": -2}
          ]
        },
        "transit_score": {
          "source_field": "transit_score",
          "direction": "higher_is_better",
          "thresholds": [
            {"min": 70, "score": 2},
            {"min": 50, "max": 70, "score": 1},
            {"min": 30, "max": 50, "score": 0},
            {"min": 15, "max": 30, "score": -1},
            {"max": 15, "score": -2}
          ]
        }
      }
    },
    "education": {
      "label": "Education",
      "weight": 1,
      "indicators": {
        "bachelors_vs_national": {
          "source_field": "bachelors_plus_pct",
