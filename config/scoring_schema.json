          "thresholds": [
            {"min_dev": 5, "score": 2},
            {"min_dev": 0, "max_dev": 5, "score": 1},
            {"min_dev": -5, "max_dev": 0, "score": 0},
            {"min_dev": -15, "max_dev": -5, "score": -1},
            {"max_dev": -15, "score": -2}
          ]
        }
      }
    },
    "public_safety": {
      "label": "Public Safety",
      "weight": 1,
      "indicators": {
        "violent_crime_rate": {
          "source_field": "violent_crime_rate",
          "direction": "lower_is_better",
          "thresholds": [
            {"max": 200, "score": 2},
            {"min": 200, "max": 380, "score": 1},
            {"min": 380, "max": 500, "score": 0},
            {"min": 500, "max": 700, "score": -1},
            {"min": 700, "score": -2}
          ]
        },
        "homicide_trend_pct": {
          "source_field": "homicide_trend_pct",
          "direction": "lower_is_better",
          "thresholds": [
            {"max": -15, "score": 2},
            {"min": -15, "max": -3, "score": 1},
            {"min": -3, "max": 3, "score": 0},
            {"min": 3, "max": 15, "score": -1},
            {"min": 15, "score": -2}
          ]
        }
      }
