            "Very Low": 2,
            "Relatively Low": 1,
            "Relatively Moderate": 0,
            "Relatively High": -1,
            "Very High": -2
          }
        },
        "tornado_risk": {
          "source_field": "hazard_scores.tornado",
          "type": "categorical",
          "categories": {
            "Very Low": 2,
            "Relatively Low": 1,
            "Relatively Moderate": 0,
            "Relatively High": -1,
            "Very High": -2
          }
        },
        "hurricane_risk": {
          "source_field": "hazard_scores.hurricane",
          "type": "categorical",
          "categories": {
            "Very Low": 2,
            "Relatively Low": 1,
            "Relatively Moderate": 0,
            "Relatively High": -1,
            "Very High": -2
          }
        },
        "flood_risk": {
          "source_field": "hazard_scores.flood",
          "type": "categorical",
          "categories": {
            "Very Low": 2,
            "Relatively Low": 1,
            "Relatively Moderate": 0,
            "Relatively High": -1,
            "Very High": -2
          }
        },
        "heat_wave_risk": {
          "source_field": "hazard_scores.heat_wave",
          "type": "categorical",
          "categories": {
            "Very Low": 2,
            "Relatively Low": 1,
            "Relatively Moderate": 0,
            "Relatively High": -1,
            "Very High": -2
          }
        }
      }
    },
    "quality_of_life": {
      "label": "Quality of Life",
      "weight": 1,
      "indicators": {
        "walk_score": {
          "source_field": "walk_score",
          "direction": "higher_is_better",
          "thresholds": [
            {"min": 80, "score": 2},
            {"min": 70, "max": 80, "score": 1},
            {"min": 50, "max": 70, "score": 0},
            {"min": 30, "max": 50, "score": -1},
            {"max": 30, "score": -2}
          ]
        },
        "cost_of_living_proxy": {
          "source_field": "median_sale_price",
          "type": "ratio",
          "national_benchmark": 332700,
          "thresholds": [
            {"max_ratio": 0.60, "score": 2},
            {"min_ratio": 0.60, "max_ratio": 0.85, "score": 1},
            {"min_ratio": 0.85, "max_ratio": 1.15, "score": 0},
            {"min_ratio": 1.15, "max_ratio": 1.50, "score": -1},
            {"min_ratio": 1.50, "score": -2}
          ]
        }
      }
    }
  },
  "composite": {
    "range": [-18, 18],
    "bands": [
      {"max": -9, "label": "Severe Decline"},
      {"min": -8, "max": -4, "label": "Declining"},
      {"min": -3, "max": 3, "label": "Stable"},
      {"min": 4, "max": 8, "label": "Growing"},
      {"min": 9, "label": "Rapid Growth"}
    ]
  }
}
